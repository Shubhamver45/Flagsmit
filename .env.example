# Flagsmith API Configuration
FLAGSMITH_URL=http://localhost:8000/api/v1
FLAGSMITH_ADMIN_API_KEY=your_master_admin_api_key
FLAGSMITH_ENVIRONMENT_KEY=your_client_environment_key
FLAGSMITH_ORG_ID=1
FLAGSMITH_PROJECT_ID=1
FLAGSMITH_ENVIRONMENT_ID=1

# ClickHouse Experimentation Warehouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=flagsmith
CLICKHOUSE_PASSWORD=your_clickhouse_password
CLICKHOUSE_DB=flagsmith_exp

# Initial Flagsmith Admin Credentials (for setup)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password

# Webhooks (Optional)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
# GENERIC_WEBHOOK_URL=https://api.example.com/rollout-webhooks
