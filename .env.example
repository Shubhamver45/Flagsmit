# ============================================================
# SwitchGuard – Environment Variable Template
# Copy to .env and fill in real values.  Never commit .env.
# ============================================================

# ----------------------------------------------------------
# Flagsmith (self-hosted) connection
# ----------------------------------------------------------
FLAGSMITH_URL=http://localhost:8000/api/v1
FLAGSMITH_ADMIN_API_KEY=your_master_admin_api_key
FLAGSMITH_ENVIRONMENT_KEY=your_client_environment_key
FLAGSMITH_ORG_ID=1
FLAGSMITH_PROJECT_ID=1
FLAGSMITH_ENVIRONMENT_ID=1

# Optional: a second, lower-privilege API key used only by
# the demo's simulated "ops-engineer" operator
FLAGSMITH_OPS_API_KEY=your_ops_api_key

# ----------------------------------------------------------
# Webhook security (HMAC-SHA256)
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
# ----------------------------------------------------------
FLAGSMITH_WEBHOOK_SECRET=your-webhook-secret-here

# ----------------------------------------------------------
# SwitchGuard API token (write endpoints: /approve /rollback /reset /tick /pause /resume)
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# In demo mode this is generated automatically by setup_flagsmith.py.
# In production mode this MUST be set or the service refuses to start.
# ----------------------------------------------------------
GUARDIAN_API_TOKEN=your_secure_guardian_token_here

# ----------------------------------------------------------
# Runtime mode: "demo" (default) or "production"
# In production mode SwitchGuard refuses to start without
# GUARDIAN_API_TOKEN and FLAGSMITH_WEBHOOK_SECRET.
# ----------------------------------------------------------
GUARDIAN_ENV=demo

# ----------------------------------------------------------
# Initial Flagsmith Admin Credentials (for setup_flagsmith.py)
# DEMO ONLY – use throwaway credentials in demo mode.
# ----------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password

# ----------------------------------------------------------
# Optional integrations
# ----------------------------------------------------------
SLACK_WEBHOOK_URL=
# GENERIC_WEBHOOK_URL=https://api.example.com/rollout-webhooks

# Demo App Authentication (protects /toggle-bug and /reset-metrics)
# DEMO_API_TOKEN=your_secure_demo_token_here

# ----------------------------------------------------------
# Demo-only tunables (safe to omit in production)
# ----------------------------------------------------------
# Force Flagsmith to recalculate experiment results immediately.
# DEMO ONLY – not suitable for production traffic.
# DEMO_FORCE_RECALC=1

# SSRF allowlist for Flagsmith webhooks back to Guardian inside Docker.
# DEMO ONLY – lock down to real host/IP in production.
# SSRF_ALLOWED_HOSTS=host.docker.internal,127.0.0.1,localhost
