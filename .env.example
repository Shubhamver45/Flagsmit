# Flagsmith API Configuration
FLAGSMITH_URL=http://localhost:8000/api/v1
FLAGSMITH_ADMIN_API_KEY=your_master_admin_api_key
FLAGSMITH_ENVIRONMENT_KEY=your_client_environment_key
FLAGSMITH_ORG_ID=1
FLAGSMITH_PROJECT_ID=1
FLAGSMITH_ENVIRONMENT_ID=1

# Flagsmith Experimentation Recalculation (Optional)
# In production, Flagsmith throttles experiment recalculation to once every 300s (5 min).
# Set DEMO_FORCE_RECALC=1 only in rapid demo/testing environments to bypass throttle via task processor.
# DEMO_FORCE_RECALC=1

# Initial Flagsmith Admin Credentials (for setup)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password

# Webhooks (Optional)
SLACK_WEBHOOK_URL=
# GENERIC_WEBHOOK_URL=https://api.example.com/rollout-webhooks

# Guardian API Authentication (Optional for local dev, recommended for production)
# When set, write endpoints (/approve, /rollback, /reset, /tick) require Bearer token
# GUARDIAN_API_TOKEN=your_secure_guardian_token_here

# Demo App Authentication (Optional, protects /toggle-bug and /reset-metrics)
# DEMO_API_TOKEN=your_secure_demo_token_here
